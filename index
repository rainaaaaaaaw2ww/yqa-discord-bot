<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <title>Discord &#36523;&#20998;&#32068;&#25511;&#21046;&#21488;</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #313338;
      color: white;
      padding: 40px;
    }

    form, .panel {
      max-width: 560px;
      background: #2b2d31;
      padding: 24px;
      border-radius: 8px;
    }

    label {
      display: block;
      margin-top: 16px;
      margin-bottom: 6px;
    }

    input, select, textarea, button {
      width: 100%;
      box-sizing: border-box;
      padding: 10px;
      border-radius: 6px;
      border: none;
      font-size: 15px;
    }

    .roles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 8px;
      max-height: 260px;
      overflow: auto;
    }

    .role-option {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0;
      padding: 8px;
      background: #1e1f22;
      border-radius: 6px;
    }

    .role-option input {
      width: auto;
    }

    .hint {
      color: #b5bac1;
      font-size: 13px;
      margin-top: 6px;
    }

    textarea {
      height: 120px;
      resize: vertical;
    }

    button {
      margin-top: 20px;
      background: #5865f2;
      color: white;
      cursor: pointer;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Discord &#36523;&#20998;&#32068;&#25511;&#21046;&#21488;</h1>

  <div class="panel">
    <label>&#36984;&#25799;&#20282;&#26381;&#22120;</label>
    <select onchange="if (this.value) location.href='/guild/' + this.value">
      <option value="">&#35531;&#36984;&#25799;&#20282;&#26381;&#22120;</option>
      {% for guild in guilds %}
        <option value="{{ guild.id }}" {% if selected_guild is defined and selected_guild and selected_guild.id == guild.id %}selected{% endif %}>
          {{ guild.name }}
        </option>
      {% endfor %}
    </select>
  </div>

  {% if selected_guild is defined and selected_guild %}
  <form method="POST" action="/send" style="margin-top: 20px;">
    <input type="hidden" name="guild_id" value="{{ selected_guild.id }}">

    <label>&#24460;&#21488;&#23494;&#30908;</label>
    <input type="password" name="password" required>

    <label>&#30332;&#36865;&#38971;&#36947;</label>
    <select name="channel_id" required>
      {% for channel in channels %}
        <option value="{{ channel.id }}"># {{ channel.name }}</option>
      {% endfor %}
    </select>

    <label>&#36984;&#25799;&#35201;&#35722;&#25104;&#25353;&#37397;&#30340;&#36523;&#20998;&#32068;</label>
    <div class="hint">Discord &#19968;&#21063;&#35338;&#24687;&#26368;&#22810;&#25918; 25 &#20491;&#36523;&#20998;&#32068;&#25353;&#37397;&#12290;</div>
    <div class="roles">
      {% for role in roles %}
        <label class="role-option">
          <input type="checkbox" name="role_ids" value="{{ role.id }}">
          <span>{{ role.name }}</span>
        </label>
      {% endfor %}
    </div>

    <label>Embed &#27161;&#38988;</label>
    <input name="title" value="&#35531;&#36984;&#25799;&#20320;&#30340;&#36523;&#20998;&#32068;" required>

    <label>Embed &#20839;&#23481;</label>
    <textarea name="description" required>&#35531;&#25353;&#19979;&#26041;&#25353;&#37397;&#36984;&#25799;&#12290;</textarea>

    <label>Embed &#38991;&#33394;</label>
    <input type="color" name="color" value="#5865f2">

    <button type="submit">&#36865;&#20986;&#21040; Discord</button>
  </form>
  {% endif %}
</body>
</html>
